COMPOSE_PROJECT_NAME=kobo-nextgen
DEPLOY_TARGET=docker
HELM_PROFILE=basic
GKE_STATIC_IP_NAME=
GKE_MANAGED_CERTIFICATE_ENABLED=0
GKE_MANAGED_CERTIFICATE_NAME=kobo-managed-certificate
GKE_SERVICE_ACCOUNT_EMAIL=
GKE_STATIC_STORAGE_CLASS=standard-rwx
GKE_RESOURCE_ACTION=existing
GCP_PROJECT_ID=
GCP_REGION=us-central1
GKE_CLUSTER_NAME=kobo
GCP_NETWORK=kobo-vpc
GCP_SUBNETWORK=kobo-gke
GKE_SUBNET_RANGE=10.20.0.0/20
GKE_STATIC_IP_ADDRESS=
GKE_KSA_NAME=kobo-kobo-nextgen
HELM_RELEASE=kobo
HELM_NAMESPACE=kobo
GKE_MANAGE_DNS=0
GCP_DNS_ZONE_NAME=kobo-public
NEWT_DOCKER_NETWORK=newt
KPI_DNS_SERVER=127.0.0.11
DEPLOY_MODE=local
EXTERNAL_PROXY_ENABLED=0
# Compose requires a literal boolean for the network's `external` property.
# install.sh keeps this synchronized with EXTERNAL_PROXY_ENABLED.
NEWT_NETWORK_EXTERNAL=false
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_BIND_PORT=8080
NGINX_INTERNAL_API_PORT=8080
PUBLIC_DOMAIN_NAME=example.org
KOBOFORM_PUBLIC_SUBDOMAIN=kf
KOBOCAT_PUBLIC_SUBDOMAIN=kc
ENKETO_PUBLIC_SUBDOMAIN=ee
INTERNAL_DOMAIN_NAME=kobo.internal
KOBOFORM_DOCKER_ALIAS=kf.localhost
KOBOCAT_DOCKER_ALIAS=kc.localhost
ENKETO_DOCKER_ALIAS=ee.localhost
PUBLIC_REQUEST_SCHEME=https

# Cloud SQL Auth Proxy. The runtime credential is never committed to Git.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance
CLOUD_SQL_ENABLED=0
CLOUD_SQL_PROXY_IMAGE=gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.14.1
GOOGLE_SERVICE_ACCOUNT_FILE=runtime/secrets/google/service-account.json

# Private MongoDB 8 endpoint. Include the database name in the URI.
MONGO_DB_URL='mongodb://kobo_app:CHANGE_ME@mongo.internal:27017/formhub?tls=true&replicaSet=rs0'
MONGO_ROOT_USERNAME=kobo
MONGO_ROOT_PASSWORD=CHANGE_ME

# External Redis main. Leave empty to use the `local-redis-main` profile.
REDIS_MAIN_URL=rediss://:CHANGE_ME@redis.internal:6379/0
REDIS_MAIN_HOST=redis-main
REDIS_MAIN_PORT=6379
REDIS_MAIN_SCHEME=redis
REDIS_MAIN_PASSWORD=CHANGE_ME

# Local cache/session Redis.
REDIS_CACHE_PASSWORD=CHANGE_ME
REDIS_CACHE_PORT=6379

# GCS FUSE media bucket and mount options.
GCS_BUCKET_NAME=project-kobo-media
GCS_MOUNT_PATH=./runtime/media-mount
GCS_FUSE_IMAGE=kobo-nextgen/gcsfuse:local

# Application secrets. Generate these with scripts/render-config.sh.
DJANGO_SECRET_KEY=GENERATE
ENKETO_API_KEY=GENERATE
ENKETO_ENCRYPTION_KEY=GENERATE
ENKETO_LESS_SECURE_ENCRYPTION_KEY=GENERATE
KOBO_SUPERUSER_USERNAME=super_admin
KOBO_SUPERUSER_PASSWORD=GENERATE
POSTGRES_USER=kobo
POSTGRES_PASSWORD=CHANGE_ME
KC_POSTGRES_DB=kobocat
KPI_POSTGRES_DB=koboform
MONGO_DB_NAME=formhub
MONGO_USER_USERNAME=kobo
MONGO_USER_PASSWORD=CHANGE_ME

# Set to 1 only after the GCS FUSE image and mount probe are validated.
GCS_FUSE_ENABLED=0
# Set to 1 to enable the optional local Redis-main service.
LOCAL_REDIS_MAIN=0
REDIS_BACKEND=external
MEMORYSTORE_CONNECTIVITY=same-vpc
MEMORYSTORE_INSTANCE_NAME=kobo-redis
MEMORYSTORE_TIER=basic
MEMORYSTORE_SIZE_GB=5
MEMORYSTORE_PORT=6379
MEMORYSTORE_TLS_ENABLED=0
MEMORYSTORE_AUTH_STRING=
MEMORYSTORE_PSA_RANGE_NAME=kobo-memorystore-range
MEMORYSTORE_PSA_PREFIX_LENGTH=24
PSC_SERVICE_ATTACHMENT=
PSC_ENDPOINT_NAME=kobo-redis-psc
PSC_SUBNET_NAME=kobo-psc
PSC_SUBNET_RANGE=10.20.240.0/24
