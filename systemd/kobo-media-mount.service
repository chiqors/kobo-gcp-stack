[Unit]
Description=Kobo GCS FUSE media mount
After=docker.service network-online.target kobo-media-bind.service
Requires=docker.service
Wants=kobo-media-bind.service network-online.target
Before=kobo-nextgen.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=__KOBO_USER__
WorkingDirectory=__KOBO_ROOT__
ExecStart=__KOBO_ROOT__/scripts/deploy.sh media-up
ExecStop=__KOBO_ROOT__/scripts/deploy.sh media-down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
